#include<stdio.h>
#include<stdlib.h>

void nhap(int **a, int h, int c) {
	for (int i = 0; i < h; i++) {
		for (int j = 0; j < c; j++)
			scanf("%d", &a[i][j]);
	}
}
void in(int **a, int h, int c) {
	for (int i = 0; i < h; i++) {
		for (int j = 0; j < c; j++)
			printf("%d ", a[i][j]);
		printf("\n");
	}
}
int main() {
	int **a;
	int h, c;
	scanf("%d%d", &h, &c);
	a = (int**)malloc(h * sizeof(int*));
	for (int i = 0; i < h; i++) {
		a[i] = (int *)malloc(c * sizeof(int));
	}
	nhap(a, h, c);
	in(a, h, c);
	for (int j = 0; j < h; j++) {
		free(a[j]);
	}
	free(a);
	return 0;
}
